#
# Copy to `.env` beside this file — `nextcloud_app/dev up` does that for you on
# first run. `.env` is gitignored and must stay that way: CAIRN_SEED_DIR points
# at real health data.

# Where `dev seed` reads the OMH files from.
#
# Point this at a folder that contains manifest.json and the metric directories
# — that is, the `Cairn` folder itself, not the folder holding it. Leave it unset
# and the dev environment generates a synthetic tree instead, so a fresh clone
# still comes up populated.
#
# NOTE: a real export is personal health data. It is copied into a Docker volume,
# never into this repository. `dev reset` destroys that volume, and is the way to
# erase it.
#CAIRN_SEED_DIR=/home/you/Downloads/Cairn

# Host port for http://localhost:<port>. Always bound to 127.0.0.1 by
# compose.yaml, so changing this cannot expose the instance to your network.
#CAIRN_DEV_PORT=8080

# Admin login for the dev instance. Defaults to admin / admin, which is safe
# only because the port is bound to loopback — keep it that way.
#
# The user name becomes a path component inside the container, so it is
# restricted to letters, digits, dot, dash and underscore.
#CAIRN_ADMIN_USER=admin
#CAIRN_ADMIN_PASSWORD=admin
